{
  "manifest_version": 3,
  "name": "YT音轨翻译",
  "short_name": "YT音轨翻译",
  "version": "1.0.1",
  "description": "直接监听标签页音轨，用本地 Speaches / faster-whisper 识别，再翻译成简体中文。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "YT音轨翻译",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "clipboardWrite",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "http://127.0.0.1:11434/*",
    "http://127.0.0.1:8000/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/shared/languages.js",
        "src/shared/text.js",
        "src/content/youtube.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-audio": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "开始/停止 DS 实时音频翻译"
    }
  }
}
